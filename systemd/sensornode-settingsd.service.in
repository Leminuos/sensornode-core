[Unit]
Description=SensorNode settings daemon
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=-@CMAKE_INSTALL_FULL_SYSCONFDIR@/default/sensornode-settingsd
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/sensornode-settingsd $SETTINGSD_ARGS
User=sensornode
Group=sensornode
StateDirectory=sensornode-settings
ReadWritePaths=/run/sensornode

WatchdogSec=30s
TimeoutStartSec=30s
Restart=on-failure
RestartSec=2s
RestartPreventExitStatus=2

CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
DevicePolicy=closed
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
